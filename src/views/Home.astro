---
import { NavBar } from "../components/NavBar";
import { Hero } from "../components/Hero";
import { LandingInteractions } from "../components/LandingInteractions";
import { Manifesto } from "../components/Manifesto";
import { CTA } from "../components/CTA";
import { Faq } from "../components/Faq";
import { Footer } from "../components/Footer";
import { Process } from "../components/Process";
import { Services } from "../components/Services";
import { Work } from "../components/Work";
import { faqs } from "../data/faq";
import Layout from "../layouts/Layout.astro";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	inLanguage: lang === "en" ? "en" : "es-MX",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.q[lang],
		acceptedAnswer: { "@type": "Answer", text: item.a[lang] },
	})),
};

const alternates = { es: "/", en: "/en/" };
---

<Layout
	lang={lang}
	alternates={alternates}
	canonical={alternates[lang]}
	jsonLd={[faqJsonLd]}
>
	<NavBar lang={lang} alternates={alternates} />

	<main id="main">
		<a id="top"></a>

		<Hero />
		<Manifesto />
		<Services />
		<Process />

		<!-- Hidrata solo lo que tiene estado: el modal de proyectos -->
		<Work lang={lang} client:load />

		<Faq />
		<CTA />
	</main>

	<Footer lang={lang} />

	<LandingInteractions client:load />
</Layout>
